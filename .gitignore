# ==============================================================================
#  书脉 BookPulse · .gitignore
# ==============================================================================

# ---------------------------------------------------------------- Python 环境
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-wheel-metadata/
*.egg-info/
.eggs/

# ---------------------------------------------------------------- 打包产物
build/
dist/
dist_fast/
*.spec
!requirements*.txt

# ---------------------------------------------------------------- 用户数据 ★关键
# data/ 里有你的本地书库（hotmarks.db）和 settings.json（可能含 API Key），
# exports/ 是你导出的个人文件 —— 这两者绝对不能提交。
data/
exports/
covers/

# ---------------------------------------------------------------- 打包成品
# 46MB 的 exe 走 GitHub Releases 分发，不进 git（否则 clone 会非常慢）
分发版/
*.exe

# ---------------------------------------------------------------- 本地备份 / 临时
_整理备份_*/
_*/
*.log
_smoke*
_shot*
_temp*
tmp/

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store
